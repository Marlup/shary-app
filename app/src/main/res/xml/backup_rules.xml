<?xml version="1.0" encoding="utf-8"?>
<!--
   Shary is zero-knowledge. Android backup and device transfer are disabled in
   the manifest; these exclusions are defense-in-depth if backup is ever
   re-enabled. Do not add includes without an L2/L6 privacy review.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
